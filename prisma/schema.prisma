// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubscriptionStatus {
  REGULAR
  PREMIUM
  INACTIVE
}

enum Role {
  STAFF
  ADMIN
  SUPERUSER
}

enum PaymentMethod {
  CASH
  CARD
  EWALLET
}

model Tenant {
  id                 String             @id @default(uuid())
  clerkOrgId         String             @unique
  clerkOrgSlug       String             @unique
  shopName           String
  contactPerson      String
  contactPosition    String?
  phone              String
  address            String
  email              String
  timeZone           String             @default("Asia/Manila")
  subscriptionStatus SubscriptionStatus @default(REGULAR)
  createdAt          DateTime           @default(now())

  users          User[]
  machines       Machine[]
  inventoryItems InventoryItem[]
  inventoryTxns  InventoryTransaction[]
  orders         LaundryOrder[]
  expenses       Expense[]
  MachineUsage   MachineUsage[]
  services       Service[]
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  clerkId   String   @unique
  name      String
  email     String
  phone     String?
  role      String // admin, staff
  createdAt DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  expenses Expense[]
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  name      String   @unique
  phone     String?
  email     String?
  createdAt DateTime @default(now())

  orders LaundryOrder[]
}

enum LaundryOrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LaundryOrderType {
  WALK_IN
  DELIVERY
}

model LaundryOrder {
  id            String             @id @default(uuid())
  tenantId      String
  userId        String             @default("system")
  customerId    String?
  status        LaundryOrderStatus @default(PENDING) // pending, in_progress, completed, paid
  orderType     LaundryOrderType   @default(WALK_IN)
  total         Float
  paid          Boolean            @default(false)
  paidAt        DateTime?
  paymentMethod PaymentMethod? // cash, card, gcash
  createdAt     DateTime           @default(now())

  customer      Customer?      @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  payments      Payment[]
  machineUsages MachineUsage[]
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
}

model OrderItem {
  id              Int     @id @default(autoincrement())
  orderId         String
  serviceId       String?
  inventoryItemId String?
  supplyId        Int? // detergent, conditioner
  price           Float
  quantity        Int

  order         LaundryOrder   @relation(fields: [orderId], references: [id])
  service       Service?       @relation(fields: [serviceId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
}

enum ServiceType {
  WASH
  DRY
  OTHERS
}

model Service {
  id        String      @id @default(uuid())
  tenantId  String
  type      ServiceType
  name      String // e.g. "Wash", "Dry", "Fold"
  price     Float
  duration  Int? // optional: minutes per cycle
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  orderItems OrderItem[]
}

model Payment {
  id        Int      @id @default(autoincrement())
  orderId   String
  amount    Float
  method    String // cash, card, gcash
  createdAt DateTime @default(now())

  order LaundryOrder @relation(fields: [orderId], references: [id])
}

model InventoryItem {
  id        String   @id @default(uuid())
  tenantId  String
  name      String // e.g. "Detergent", "Fabric Conditioner", "Laundry Bag"
  type      String // "retail" | "consumable"
  unit      String // ml, pack, sachet
  stock     Int      @default(0)
  threshold Int      @default(0)
  price     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions InventoryTransaction[]
  orderItems   OrderItem[]
  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
}

model InventoryTransaction {
  id              Int      @id @default(autoincrement())
  inventoryItemId String
  tenantId        String
  type            String // restock | sale | usage
  quantity        Int
  unitPrice       Float?
  createdAt       DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
}

enum MachineType {
  washer
  dryer
}

enum MachineStatus {
  AVAILABLE // machine is idle and ready for use
  IN_USE // machine is currently running a cycle
  UNAVAILABLE // machine is under maintenance or offline
}

model Machine {
  id         String        @id @default(uuid())
  tenantId   String
  name       String // Washer 1, Dryer 2
  type       MachineType // washer | dryer
  status     MachineStatus @default(AVAILABLE) // available, in_use, maintenance
  usageCount Int           @default(0)
  location   String?
  comment    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  usages MachineUsage[]
  tenant Tenant         @relation(fields: [tenantId], references: [id])
}

model MachineUsage {
  id        String    @id @default(uuid())
  machineId String
  orderId   String
  tenantId  String
  cycleType String // wash | dry
  duration  Int // minutes
  fee       Float
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  machine Machine      @relation(fields: [machineId], references: [id])
  order   LaundryOrder @relation(fields: [orderId], references: [id])
  tenant  Tenant       @relation(fields: [tenantId], references: [id])
}

model Expense {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  category  String // utilities, rent, maintenance, supplies, other
  amount    Float
  notes     String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}
