// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubscriptionStatus {
  REGULAR
  PREMIUM
  INACTIVE
}

enum Role {
  STAFF
  ADMIN
  SUPERUSER
}

model Tenant {
  id                 String             @id @default(uuid())
  clerkOrgId         String             @unique
  clerkOrgSlug       String             @unique
  shopName           String
  contactPerson      String
  contactPosition    String?
  phone              String
  address            String
  email              String
  subscriptionStatus SubscriptionStatus @default(REGULAR)
  createdAt          DateTime           @default(now())

  users          User[]
  machines       Machine[]
  inventoryItems InventoryItem[]
  inventoryTxns  InventoryTransaction[]
  orders         LaundryOrder[]
  expenses       Expense[]
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  clerkId   String   @unique
  name      String
  email     String
  phone     String?
  role      String // admin, staff
  createdAt DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  expenses Expense[]
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())

  orders LaundryOrder[]
}

model LaundryOrder {
  id            String   @id @default(uuid())
  tenantId      String
  customerId    String?
  status        String   @default("pending") // pending, in_progress, completed, paid
  total         Float
  paymentMethod String? // cash, card, gcash
  createdAt     DateTime @default(now())

  customer      Customer?      @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  payments      Payment[]
  machineUsages MachineUsage[]
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
}

model OrderItem {
  id              Int     @id @default(autoincrement())
  orderId         String
  inventoryItemId String
  service         String? // wash, dry, fold
  supplyId        Int? // detergent, conditioner
  price           Float
  quantity        Int

  order         LaundryOrder   @relation(fields: [orderId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
}

model Payment {
  id        Int      @id @default(autoincrement())
  orderId   String
  amount    Float
  method    String // cash, card, gcash
  createdAt DateTime @default(now())

  order LaundryOrder @relation(fields: [orderId], references: [id])
}

model InventoryItem {
  id        String   @id @default(uuid())
  tenantId  String
  name      String // e.g. "Detergent", "Fabric Conditioner", "Laundry Bag"
  type      String // "retail" | "consumable"
  unit      String // ml, pack, sachet
  stock     Int      @default(0)
  price     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions InventoryTransaction[]
  orderItems   OrderItem[]
  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
}

model InventoryTransaction {
  id              Int      @id @default(autoincrement())
  inventoryItemId String
  tenantId        String
  type            String // restock | sale | usage
  quantity        Int
  unitPrice       Float?
  createdAt       DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
}

model Machine {
  id         String   @id @default(uuid())
  tenantId   String
  name       String // Washer 1, Dryer 2
  type       String // washer | dryer
  status     String   @default("available") // available, in_use, maintenance
  usageCount Int      @default(0)
  location   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  usages MachineUsage[]
  tenant Tenant         @relation(fields: [tenantId], references: [id])
}

model MachineUsage {
  id        Int       @id @default(autoincrement())
  machineId String
  orderId   String
  cycleType String // wash | dry
  duration  Int // minutes
  fee       Float
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  machine Machine      @relation(fields: [machineId], references: [id])
  order   LaundryOrder @relation(fields: [orderId], references: [id])
}

model Expense {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  category  String // utilities, rent, maintenance, supplies, other
  amount    Float
  notes     String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}
